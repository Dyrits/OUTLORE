{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git push": "ask",
      "git push *": "ask",
      "git push --dry-run*": "allow",
      "git -*": "ask",
      "git commit *--no-verify*": "ask",
      "git commit -*n*": "ask",
      "git reset --hard*": "ask",
      "git clean -*f*": "ask",
      "git clean -n*": "allow",
      "git clean --dry-run*": "allow",
      "git branch -D *": "ask",
      "git branch -*f*": "ask",
      "git branch --force*": "ask",
      "git rm -*f*": "ask",
      "git rm --force*": "ask",
      "git merge --abort*": "ask",
      "git update-ref -d*": "ask",
      "git checkout .": "ask",
      "git checkout -- *": "ask",
      "git checkout -f*": "ask",
      "git switch --discard-changes*": "ask",
      "git restore *": "ask",
      "git restore --staged *": "allow",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git worktree remove --force*": "ask",
      "git reflog expire*": "ask",
      "git gc --prune*": "ask"
    }
  }
}
